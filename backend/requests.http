### Get all users
GET http://localhost:8080/api/users


### Create user
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "Marko",
  "lastName": "Markovic",
  "email": "marko@example.com"
}

### Create another user
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Jovanovic",
  "email": "ana@example.com"
}

### Update user
PUT http://localhost:8080/api/users/2
Content-Type: application/json

{
  "firstName": "Ana",
  "lastName": "Petrovic",
  "email": "ana.petrovic@example.com"
}

### Delete user
DELETE http://localhost:8080/api/users/2

### Get deleted user
GET http://localhost:8080/api/users/2

### Create user using DTO
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "Nikola",
  "lastName": "Nikolic",
  "email": "nikola@example.com"
}


### Korinsik ne moze sam da setuje id, dodeljuje se automatski
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "id": 999,
  "firstName": "Petar",
  "lastName": "Petrovic",
  "email": "petar@example.com"
}

### Create valid user
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "Jovan",
  "lastName": "Jovanovic",
  "email": "jovan@example.com"
}

### Create invalid user
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "",
  "lastName": "J",
  "email": "banana"
}


### Get invalid user ID
GET http://localhost:8080/api/users/999

### Same email address test
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "firstName": "Milan",
  "lastName": "Milic",
  "email": "milan@example.com"
}

### Update user
PUT http://localhost:8080/api/users/1
Content-Type: application/json

{
  "firstName": "Marko",
  "lastName": "Markovic",
  "email": "marko.novi@example.com"
}

### Update user with invalid data
PUT http://localhost:8080/api/users/1
Content-Type: application/json

{
  "firstName": "",
  "lastName": "M",
  "email": "banana"
}

### Create project
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "name": "WorkFlow",
  "description": "Full-stack project management application",
  "ownerId": 1
}

### Create project with nonexistent owner
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "name": "Test Project",
  "description": "Testing invalid owner",
  "ownerId": 99999
}

### Get all projects
GET http://localhost:8080/api/projects

### Get project by ID
GET http://localhost:8080/api/projects/1

### Get nonexistent project
GET http://localhost:8080/api/projects/99999

### Create another project
POST http://localhost:8080/api/projects
Content-Type: application/json

{
  "name": "Portfolio Website",
  "description": "Personal portfolio project",
  "ownerId": 1
}

### Update project
PUT http://localhost:8080/api/projects/1
Content-Type: application/json

{
  "name": "WorkFlow Updated",
  "description": "Updated full-stack project management application",
  "ownerId": 1
}

### Update nonexistent project
PUT http://localhost:8080/api/projects/99999
Content-Type: application/json

{
  "name": "Test",
  "description": "Test description",
  "ownerId": 1
}

### Delete project
DELETE http://localhost:8080/api/projects/2

### Get deleted project
GET http://localhost:8080/api/projects/2